---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Adams Rosales — About">
  <Header />
  <main class="mx-auto max-w-[700px] px-6 py-8 md:py-12">
    <div class="mb-8 flex justify-center">
      <img
        src="https://pub-953ed6a419e44ac7adb24e23fcf72b84.r2.dev/self.jpeg"
        alt="Adams Rosales"
        width="288"
        height="288"
        class="h-72 w-72 rounded-full object-cover"
      />
    </div>
    <div class="space-y-6 text-lg leading-relaxed tracking-wide text-text">
      <p class="font-[Cormorant_Garamond] text-2xl italic">
        Hi, I'm Adams!
      </p>
      <p>
        My interests span nature and travel photography, and I shoot everything you see here myself.
        No AI generated content, just real moments through a real lens.
      </p>
      <p>
        When I'm not behind the camera, you can find me hunting, fishing, cooking, or out in the garden.
        By day I work as a software engineer specializing in challenging data problems.
      </p>
      <p>
        Thanks for stopping by.
      </p>
      <p>
        Protect public land.
      </p>
    </div>
    <blockquote class="mt-12 border-l border-muted/40 pl-6">
      <p class="font-[Cormorant_Garamond] text-xl italic leading-relaxed text-text">
        "First say to yourself what you would be; and then do what you have to do."
      </p>
      <cite class="mt-2 block text-sm not-italic tracking-wide text-muted">&mdash; Epictetus</cite>
    </blockquote>
    <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm tracking-widest uppercase text-muted">
      <a href="https://www.audubon.org/menu/conservation" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">National Audubon Society</a>
      <a href="https://www.nwf.org/Our-Work/Wildlife-Conservation" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">National Wildlife Federation</a>
      <a href="https://publiclandsalliance.org" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">Public Lands Alliance</a>
      <a href="https://www.birds.cornell.edu" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">Cornell Lab of Ornithology</a>
      <a href="https://www.backcountryhunters.org" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">Backcountry Hunters & Anglers</a>
    </div>
  </main>
  <Footer />
</Layout>
