---
interface Props {
  thumbnail: string;
  alt: string;
  index: number;
  section: string;
}

const { thumbnail, alt, index, section } = Astro.props;
---

<button
  class="photo-grid-item cursor-pointer border-0 bg-transparent p-0 outline-none"
  data-lightbox-trigger
  data-index={index}
  data-section={section}
  type="button"
  aria-label={alt}
>
  <img src={thumbnail} alt={alt} loading="lazy" decoding="async" width="400" height="400" />
</button>
