---
import PhotoCard from "./PhotoCard.astro";
import rawPhotos from "../data/photos.json";

const photos = [...rawPhotos].sort((a, b) => Number(b.id) - Number(a.id));
---

<section>
  <div class="photo-grid" style="visibility:hidden">
    {
      photos.map((photo, index) => (
        <PhotoCard
          thumbnail={photo.thumbnail}
          alt={photo.alt}
          index={index}
          section={photo.section}
          width={photo.width}
          height={photo.height}
        />
      ))
    }
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const grid = document.querySelector(".photo-grid");
    if (!grid) return;
    const items = [...grid.children];
    const count = items.length;

    let order = JSON.parse(sessionStorage.getItem("shuffleOrder") || "null");

    if (!order || order.length !== count) {
      order = Array.from({ length: count }, (_, i) => i);
      for (let i = count - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }
      sessionStorage.setItem("shuffleOrder", JSON.stringify(order));
    }

    const fragment = document.createDocumentFragment();
    order.forEach((i) => fragment.appendChild(items[i]));
    grid.appendChild(fragment);
    grid.style.visibility = "";
  });
</script>
