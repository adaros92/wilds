---
interface Props {
  showDisclaimer?: boolean;
}

const { showDisclaimer = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-[1400px] border-t border-muted/20 px-6 py-8 text-center text-xs text-muted">
  {showDisclaimer && <p class="mb-2">All photos are real and taken by me. AI is used for reducing digital noise during editing.</p>}
  <p>&copy; {year} Adams Rosales &middot; <a href="https://github.com/adaros92/wilds" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">GitHub</a> &middot; <a href="https://www.linkedin.com/in/adamsr09/" target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">LinkedIn</a> &middot</p>
</footer>
