---
import rawPhotos from "../data/photos.json";

const photos = [...rawPhotos].sort((a, b) => Number(b.id) - Number(a.id));
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
>
  <!-- Close button -->
  <button
    id="lightbox-close"
    class="absolute top-4 right-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-2xl text-muted transition-colors hover:text-text"
    type="button"
    aria-label="Close lightbox"
  >
    &times;
  </button>

  <!-- Previous button -->
  <button
    id="lightbox-prev"
    class="absolute left-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-2xl text-muted transition-colors hover:text-text"
    type="button"
    aria-label="Previous photo"
  >
    &#8249;
  </button>

  <!-- Image container -->
  <div class="flex max-h-[90vh] max-w-[90vw] flex-col items-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[80vh] max-w-full rounded-lg object-contain"
    />
    <p id="lightbox-title" class="mt-4 font-[Cormorant_Garamond] text-lg italic text-muted"></p>
  </div>

  <!-- Next button -->
  <button
    id="lightbox-next"
    class="absolute right-4 z-10 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-2xl text-muted transition-colors hover:text-text"
    type="button"
    aria-label="Next photo"
  >
    &#8250;
  </button>
</div>

<script define:vars={{ photos }}>
  document.addEventListener("astro:page-load", () => {
    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const lightboxTitle = document.getElementById("lightbox-title");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");

    let currentIndex = 0;

    function getVisibleIndices() {
      const items = document.querySelectorAll("[data-lightbox-trigger]");
      const indices = [];
      items.forEach((item) => {
        if (!item.classList.contains("hidden")) {
          indices.push(parseInt(item.dataset.index, 10));
        }
      });
      return indices;
    }

    // These URLs serve full-resolution masters, so a preload is expensive.
    // Fetch only the next one, only once, and only after the photo the viewer
    // is actually looking at has finished — never in competition with it.
    const preloaded = new Set();

    function preloadAdjacent() {
      const conn = navigator.connection;
      if (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ""))) return;

      const visible = getVisibleIndices();
      if (visible.length < 2) return;
      const pos = visible.indexOf(currentIndex);
      if (pos === -1) return;

      const nextIdx = visible[(pos + 1) % visible.length];
      if (nextIdx === currentIndex || preloaded.has(nextIdx)) return;
      preloaded.add(nextIdx);
      new Image().src = photos[nextIdx].src;
    }

    lightboxImg.addEventListener("load", preloadAdjacent);

    function showPhoto(index) {
      currentIndex = index;
      const photo = photos[index];
      lightboxImg.src = photo.src;
      lightboxImg.alt = photo.alt;
      lightboxTitle.textContent = photo.title;
    }

    const focusableSelector = 'button:not([disabled])';
    let previousFocus = null;

    function trapFocus(e) {
      const focusable = lightbox.querySelectorAll(focusableSelector);
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function openLightbox(index) {
      previousFocus = document.activeElement;
      showPhoto(index);
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
      document.addEventListener("keydown", trapFocus);
    }

    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
      document.removeEventListener("keydown", trapFocus);
      if (previousFocus) previousFocus.focus();
    }

    function nextPhoto() {
      const visible = getVisibleIndices();
      if (visible.length === 0) return;
      const pos = visible.indexOf(currentIndex);
      const nextPos = (pos + 1) % visible.length;
      showPhoto(visible[nextPos]);
    }

    function prevPhoto() {
      const visible = getVisibleIndices();
      if (visible.length === 0) return;
      const pos = visible.indexOf(currentIndex);
      const prevPos = (pos - 1 + visible.length) % visible.length;
      showPhoto(visible[prevPos]);
    }

    // Trigger buttons
    document.querySelectorAll("[data-lightbox-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = parseInt(btn.dataset.index, 10);
        openLightbox(index);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);
    nextBtn.addEventListener("click", nextPhoto);
    prevBtn.addEventListener("click", prevPhoto);

    // True while the viewer has pinch-zoomed in. At that point one finger means
    // "pan around the photo", so swipe navigation has to stand down.
    function isZoomed() {
      return (window.visualViewport?.scale ?? 1) > 1.01;
    }

    // Click outside image to close
    lightbox.addEventListener("click", (e) => {
      // A pan that ends on the backdrop also produces a click; don't close
      // the lightbox out from under someone inspecting a zoomed photo.
      if (isZoomed()) return;
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    // Swipe navigation (mobile)
    const SWIPE_MIN_PX = 50;
    const SWIPE_AXIS_RATIO = 1.5; // horizontal must clearly beat vertical
    let touchStartX = 0;
    let touchStartY = 0;
    let swipeCancelled = false;

    lightbox.addEventListener("touchstart", (e) => {
      // Two fingers down is a pinch, never a swipe.
      if (e.touches.length > 1 || isZoomed()) {
        swipeCancelled = true;
        return;
      }
      swipeCancelled = false;
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    lightbox.addEventListener("touchmove", (e) => {
      // A second finger can land after the gesture already started.
      if (e.touches.length > 1 || isZoomed()) swipeCancelled = true;
    }, { passive: true });

    lightbox.addEventListener("touchend", (e) => {
      // Wait for every finger to leave before judging the gesture, otherwise
      // lifting the first finger of a pinch reads as a completed swipe.
      if (e.touches.length > 0) return;

      const cancelled = swipeCancelled;
      swipeCancelled = false;
      if (cancelled || isZoomed()) return;

      const dx = touchStartX - e.changedTouches[0].screenX;
      const dy = touchStartY - e.changedTouches[0].screenY;
      if (Math.abs(dx) < SWIPE_MIN_PX) return;
      if (Math.abs(dx) < Math.abs(dy) * SWIPE_AXIS_RATIO) return;

      if (dx > 0) nextPhoto();
      else prevPhoto();
    });

    // Trackpad swipe navigation (Mac)
    let swiping = false;

    lightbox.addEventListener("wheel", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      // Trackpad pinch and ctrl+scroll arrive as wheel events; those are zoom
      // requests, so let the browser have them.
      if (e.ctrlKey) return;
      e.preventDefault();
      if (swiping || isZoomed()) return;
      if (Math.abs(e.deltaX) > 30) {
        swiping = true;
        if (e.deltaX > 0) nextPhoto();
        else prevPhoto();
        setTimeout(() => { swiping = false; }, 400);
      }
    }, { passive: false });

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") nextPhoto();
      if (e.key === "ArrowLeft") prevPhoto();
    });
  });
</script>
